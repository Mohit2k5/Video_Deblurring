# ==============================================================================
# Git Ignore Configuration for REDS Video Deblurring
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
.venv_torch/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Datasets & Generated Split Manifests
# ------------------------------------------------------------------------------
# Exclude heavy image sequences (REDS dataset images)
data/raw/
data/raw
data/train_blur/
data/train_sharp/
data/val_blur/
data/val_sharp/
data/test_blur/
data/processed/
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff

# Generated split manifests (auto-generated by: python -m src.data.splitting)
data/manifests/*
!data/manifests/.gitkeep
splits/*.csv
splits/*.json
!splits/.gitkeep
!splits/README.md

# Preserve directory structure
!data/
!data/raw/.gitkeep
!data/processed/.gitkeep

# ------------------------------------------------------------------------------
# 4. Trained Models & Checkpoints
# ------------------------------------------------------------------------------
# Ignore all model weight formats
*.pth
*.pt
*.ckpt
*.h5
*.pb
*.bin
*.onnx
*.engine

# Checkpoint directories
checkpoints/
**/checkpoints/
reports/validation/pilot_checkpoints/
reports/data_pipeline/checkpoints/

# ------------------------------------------------------------------------------
# 5. Experiment Runs & Logs
# ------------------------------------------------------------------------------
experiments/
logs/
*.log
*.sqlite
.cache/

# ------------------------------------------------------------------------------
# 6. Generated Results, Visuals & Video Clips
# ------------------------------------------------------------------------------
# Visual comparison images and side-by-side verification clips
reports/evaluation/visuals/
reports/evaluation/held_out_per_frame_metrics.csv
reports/evaluation/*.json
reports/validation/*.json
reports/data_pipeline/*.json
reports/data_pipeline/split_report.md

# Heavy media files
*.mp4
*.avi
*.mov
*.mkv
*.gif

# Figures and plots (keep directory structure)
figures/*
!figures/.gitkeep

# ------------------------------------------------------------------------------
# 7. Jupyter & IDE Configuration
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ------------------------------------------------------------------------------
# 8. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ------------------------------------------------------------------------------
# 9. Testing & Operating System Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db
$RECYCLE.BIN/
